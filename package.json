{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:cv-runtime": "node scripts/prepare-python-bundle.cjs",
    "diedie": "./diedie",
    "dev": "./diedie",
    "vite:dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:pack": "npm run prepare:cv-runtime && npm run build && electron-builder --dir",
    "electron:build": "npm run prepare:cv-runtime && npm run build && electron-builder",
    "electron:dist:mac": "npm run prepare:cv-runtime && npm run build && electron-builder --mac dmg --x64 --arm64",
    "electron:dist:win": "npm run prepare:cv-runtime && npm run build && electron-builder --win nsis --x64",
    "electron:dist:all": "npm run prepare:cv-runtime && npm run build && electron-builder --mac dmg --x64 --arm64 --win nsis --x64"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  },
  "build": {
    "appId": "club.ghostdiedie.desktop",
    "productName": "Ghostdiedie",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/assets/*.glb"
    ],
    "mac": {
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": ".electron-bundle/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../Ghostdiedie-CV",
        "to": "cv",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.DS_Store"
        ]
      }
    ]
  }
}
